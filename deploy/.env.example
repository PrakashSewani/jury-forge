# Jury Forge — non-secret settings for `docker compose` (WP 1-13; operations.md §3).
# Copy to `.env` next to compose.yaml. Secrets never go here: they are files in ./secrets
# (init-secrets.sh). A normal install needs no change in this file.

# info by default; debug and trace warn at start.
LOG_LEVEL=info

# Optional. Leave it unset: the origin is set during setup and stored (ADR-0021). Set it only to
# freeze the origin for a pre-provisioned install; changing it then needs an edit and a restart.
# https://<host> only: no port, no path, not an IP address.
# PUBLIC_URL=https://review.example.com
