# Jury Forge — Caddy in front of `app` (deployment.md §4; WP 1-13, WP 1-14).
#
# Certificates are issued on demand, and Caddy asks `app` before each one. `app` allows only the
# configured origin (stored in setup, or frozen by PUBLIC_URL), only in the `caddy` TLS mode, and at
# most 5 approvals per 2 minutes. That app-side limit is ADR-0021's issuance limit: Caddy 2.11 no
# longer accepts `interval` and `burst` in `on_demand_tls`. Before an origin exists every name is
# refused, so `:443` has no certificate on a cold start.
{
	on_demand_tls {
		ask http://app:3000/api/internal/tls/allow
	}
}

:80 {
	# Caddy answers ACME HTTP-01 challenges itself; everything else moves to HTTPS.
	redir https://{host}{uri} permanent
}

:443 {
	tls {
		on_demand
	}

	# Health, metrics, and internal routes are for the Docker network, not the internet.
	@internal path /healthz /readyz /metrics /api/internal/*
	respond @internal 404

	reverse_proxy app:3000
}
