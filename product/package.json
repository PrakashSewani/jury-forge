{
  "name": "@jury-forge/product",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "cf-typegen": "wrangler types",
    "deploy": "npm run build && wrangler deploy",
    "dev": "vite dev",
    "preview": "vite preview",
    "test": "npm run test:worker && npm run test:ui",
    "test:worker": "vitest run",
    "test:ui": "vitest run --config vitest.ui.config.ts",
    "typecheck": "tsc -p tsconfig.app.json && tsc -p tsconfig.worker.json && tsc -p tsconfig.node.json"
  },
  "dependencies": {
    "@jury-forge/shared": "*",
    "@octokit/auth-app": "^8.3.1",
    "@octokit/webhooks": "^14.2.0",
