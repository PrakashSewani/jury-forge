    "hono": "^4.13.12",
    "lucide-react": "1.61.0",
    "octokit": "^5.0.5",
    "radix-ui": "1.8.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sonner": "2.0.8",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.62.4",
    "@cloudflare/vitest-plugin": "^1.3.5",
    "@msw/cloudflare": "^0.2.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "happy-dom": "^21.0.3",
    "msw": "^3.0.1",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.146.0"
