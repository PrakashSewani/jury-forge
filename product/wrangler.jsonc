{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "jury-forge",
  "routes": [{ "pattern": "jury.prakashsewani.com", "custom_domain": true }],
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-02",
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "durable_objects": {
    "bindings": [{ "name": "RUNS", "class_name": "RunEngine" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RunEngine"] }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "jury-forge",
      // This deployment's database id (`npx wrangler d1 create jury-forge`). The guided deploy
      // writes an id here for a new instance; the deploy workflow reads it from the repository.
      "database_id": "7eeae477-07f6-41e0-89f8-e891eba8979d",
    },
  ],
}
